{
  "name": "@kolibri/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch src/index.ts",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/seed.ts",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "@kolibri/shared": "*"
  }
}
