# Copy to .env and adjust. Every value has a working default.

# Port published on the host.
KOLIBRI_PORT=4000

# Signs sessions and API tokens. Leave empty to have one generated and stored
# in the data volume; set it explicitly if you run more than one instance.
#   openssl rand -hex 32
KOLIBRI_SECRET=

# Used for absolute links (invites, MCP output). No trailing slash.
KOLIBRI_PUBLIC_URL=http://localhost:4000

# Set to false once your team has signed up to close the instance.
KOLIBRI_ALLOW_SIGNUP=true

# Upload ceiling per file, in megabytes.
KOLIBRI_MAX_UPLOAD_MB=25

# How long a browser session stays valid.
KOLIBRI_SESSION_DAYS=60

# debug | info | warn | error
KOLIBRI_LOG_LEVEL=info

TZ=Europe/Berlin
