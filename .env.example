# Copy to .env and adjust — or don't: `docker compose up -d --build` works with
# nothing but defaults. Every value below is optional.
#
# How a setting here reaches the server: compose reads this file to substitute
# `${VAR}` in the compose file, and each compose file then hands the result to
# the container under `environment:`. Compose does *not* pass this file to the
# container by itself, so a variable named here and in no compose file is read
# by nobody. `npm run check:compose` is what makes sure that cannot happen —
# add a setting to the server, and that check tells you which compose files
# still have to carry it.

# ------------------------------------------------------ first-run provisioning
# Set these two and the instance comes up with its owner account already
# created — no browser step to finish the installation. Leave them empty to
# claim the instance yourself the first time you open it.
KOLIBRI_ADMIN_EMAIL=
KOLIBRI_ADMIN_PASSWORD=
KOLIBRI_ADMIN_NAME=Owner
KOLIBRI_WORKSPACE_NAME=Kolibri

# Fill an empty database with a demo workspace (projects, cycles, pages) to
# look around in. Ignored once anything exists.
KOLIBRI_SEED_DEMO=false

# ---------------------------------------------------------------- basics
KOLIBRI_PORT=4000

# Signs sessions, API tokens and unsubscribe links. Leave empty to have one
# generated and stored in the data volume; set it explicitly if you run more
# than one instance.   openssl rand -hex 32
KOLIBRI_SECRET=

# Used for absolute links in emails and MCP output. No trailing slash.
KOLIBRI_PUBLIC_URL=http://localhost:4000

# Set to false once your team has signed up to close the instance.
KOLIBRI_ALLOW_SIGNUP=true

KOLIBRI_MAX_UPLOAD_MB=25
KOLIBRI_SESSION_DAYS=60
# Read the client address from x-forwarded-for. Right behind the bundled Caddy
# or a PaaS proxy; wrong if you publish the container directly, where a client
# can then invent its own address and with it its own rate-limit allowance.
# docker-compose.lite.yml publishes port 4000 itself, so it defaults to false —
# setting this here overrides that too.
KOLIBRI_TRUST_PROXY=true

# Outgoing webhooks and Web Push endpoints may not reach private addresses —
# loopback, the RFC 1918 ranges, link-local, the cloud metadata service. Set
# this to 1 if a webhook genuinely has to post to something on your own network
# (`http://n8n:5678` and the like). See docs/deployment.md.
# KOLIBRI_ALLOW_PRIVATE_WEBHOOKS=1

KOLIBRI_LOG_LEVEL=info
TZ=Europe/Berlin

# Language for notifications and emails to someone who has not picked one in
# their profile. `en` or `de`. The interface itself follows the browser until a
# person chooses. See docs/i18n.md.
KOLIBRI_DEFAULT_LOCALE=en

# --------------------------------------------------------- single sign-on
# OpenID Connect, authorization code with PKCE. Leave the issuer empty and the
# sign-in screen stays a password form. Register Kolibri at your provider with
# the redirect URI https://your-domain/api/auth/oidc/callback and set
# KOLIBRI_PUBLIC_URL, which is what that URI is built from.
# See docs/deployment.md.
KOLIBRI_OIDC_ISSUER=
KOLIBRI_OIDC_CLIENT_ID=
KOLIBRI_OIDC_CLIENT_SECRET=
# `email` is required — it is how a sign-in is matched to an account.
KOLIBRI_OIDC_SCOPE=openid email profile
# What the button on the sign-in screen says.
KOLIBRI_OIDC_LABEL=Single sign-on
# Create an account for anybody the provider vouches for. false admits only
# people who were invited first.
KOLIBRI_OIDC_AUTO_CREATE=true
# Hide the password form and refuse password sign-in server-side. Check the
# provider can let you back in before turning this on.
KOLIBRI_OIDC_ONLY=false

# Which workspace accounts made through the provider join (slug or id). Empty
# means the instance's only workspace, if there is exactly one.
# KOLIBRI_OIDC_WORKSPACE=

# Roles from the directory. With a map set, the directory is the authority and
# a role changed inside Kolibri is overwritten on the next sign-in — except that
# the last owner of a workspace is never demoted. See docs/deployment.md.
# KOLIBRI_OIDC_GROUPS_CLAIM=groups
# KOLIBRI_OIDC_ROLE_MAP=kolibri-admins=admin, kolibri-users=member
# KOLIBRI_OIDC_DEFAULT_ROLE=member      # `none` refuses anybody in no mapped group

# ------------------------------------------------------------------ email
#
# Everything in this section, the Telegram block and the model block can also be
# set in the app: Settings -> Server, for the account that holds the instance,
# with a "send a test" button for each. What is set there wins over what is
# here, and takes effect without a restart. See docs/deployment.md.
#
# Without an SMTP relay Kolibri keeps every notification in the in-app inbox
# and sends nothing. With one, notifications are batched into a single message
# per person per window, and invites are delivered by mail.
#
# Empty means no email: notifications stay in the in-app inbox. Set a relay to
# turn delivery on:
#   smtp://user:pass@smtp.example.com:587   (STARTTLS)
#   smtps://user:pass@smtp.example.com:465  (implicit TLS)
#
# To try it locally, use the dev overlay instead of setting this by hand — it
# runs a capture inbox (Mailpit, http://localhost:8025) and wires the app to it:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# Or set COMPOSE_FILE below so plain `docker compose up -d` includes it.
KOLIBRI_SMTP_URL=
KOLIBRI_MAIL_FROM=kolibri@example.com
KOLIBRI_MAIL_FROM_NAME=Kolibri
# KOLIBRI_MAIL_REPLY_TO=team@example.com

# Or set the pieces separately, which is the shape most providers hand you.
# KOLIBRI_SMTP_HOST=smtp.example.com
# KOLIBRI_SMTP_PORT=587
# KOLIBRI_SMTP_USER=
# KOLIBRI_SMTP_PASS=

# How the connection is protected: starttls | tls | none.
#
# Unset, it follows the port — 465 is TLS from the first byte, anything else is
# STARTTLS — so the usual case needs nothing here.
#
# `starttls` is required rather than attempted: a relay that does not offer it
# gets no message, instead of a plaintext connection with the password sent over
# it. `none` is for a capture inbox on the same machine and nothing else; with
# credentials set, Kolibri refuses to connect at all.
# KOLIBRI_SMTP_ENCRYPTION=starttls

# ------------------------------------------------------------- task reviews
# A model reads a task back and suggests clearer wording. Off until two people
# switch it on: a key here, and "Task reviews" in Settings → Workspace. Manual,
# one task at a time, and it never writes anything by itself. See docs/ai.md.
#
# Whose model. Unset, it is read off whichever vendor key is present, Anthropic
# first. Naming a provider whose key is missing switches the feature off rather
# than falling through to a different company.
# KOLIBRI_AI_PROVIDER=anthropic     # anthropic | gemini | openrouter
#
# The vendor's own name is read too — ANTHROPIC_API_KEY, GEMINI_API_KEY or
# OPENROUTER_API_KEY — so a .env written for one of them works unchanged.
# KOLIBRI_AI_API_KEY=
#
# Defaults: claude-opus-5, gemini-2.5-flash, anthropic/claude-opus-4.5. This is
# the cost lever — a review is a few cents on a large model and a fraction of a
# cent on a small one.
# KOLIBRI_AI_MODEL=
#
# For a gateway, a proxy, or a model on this docker network. Anything speaking
# the OpenAI shape works through the OpenRouter adapter.
# KOLIBRI_AI_BASE_URL=
# KOLIBRI_AI_TIMEOUT_MS=20000
# How many reviews one person may ask for: a burst, then one back every N
# seconds. The only click in the app that costs money.
# KOLIBRI_AI_BURST=10
# KOLIBRI_AI_EVERY_SECONDS=20

# ---------------------------------------------- email via Scaleway (instead)
# Scaleway Transactional Email over its HTTP API, for hosts that block outbound
# SMTP ports. Same queue, batching, backoff and suppression list as a relay.
#
# `KOLIBRI_MAIL_FROM` has to be a verified sender on a verified domain. With
# both this and an SMTP host set, Scaleway wins unless KOLIBRI_MAIL_TRANSPORT
# says otherwise.
#
# The SCW_SECRET_KEY_EMAIL / SCW_PROJECT_ID / SCW_EMAIL_API_URL /
# EMAIL_FROM_INFO / EMAIL_FROM_NAME names are read too, so a `.env` written for
# Scaleway's own tooling works unchanged.
# KOLIBRI_SCALEWAY_SECRET_KEY=
# KOLIBRI_SCALEWAY_PROJECT_ID=
# fr-par is the only region the service runs in; override only to point
# somewhere else entirely.
# KOLIBRI_SCALEWAY_EMAIL_URL=https://api.scaleway.com/transactional-email/v1alpha1/regions/fr-par/emails
# KOLIBRI_MAIL_TRANSPORT=scaleway   # smtp | scaleway

# How long to collect notifications before sending one summary mail.
KOLIBRI_MAIL_BATCH_SECONDS=120
# Give up on a message after this many failed attempts (1, 2, 4 … minutes apart).
KOLIBRI_MAIL_MAX_ATTEMPTS=6

# Accept a self-signed certificate on an internal relay.
# KOLIBRI_SMTP_INSECURE=false

# ------------------------------------------------------------------- push
# Native notifications. The VAPID key pair is generated into the data directory
# on first use; set it explicitly to keep subscriptions across a restore into a
# fresh volume. See docs/notifications.md.
KOLIBRI_PUSH=true
# KOLIBRI_VAPID_PUBLIC=
# KOLIBRI_VAPID_PRIVATE=
# KOLIBRI_VAPID_SUBJECT=mailto:admin@example.com

# --------------------------------------------------------------- telegram
# Notifications in a Telegram chat. Off without a bot token, and the token is
# the only thing to configure: each person connects their own chat from inside
# the app. Get one from @BotFather. Updates are collected by long-polling, so
# this needs no public URL and works behind NAT. See docs/notifications.md.
# KOLIBRI_TELEGRAM_BOT_TOKEN=
# How long one long-poll waits, in seconds. Telegram allows up to 50.
# KOLIBRI_TELEGRAM_POLL_SECONDS=25
# Give up on one message after this many failed sends.
# KOLIBRI_TELEGRAM_MAX_ATTEMPTS=5

# A shared secret your mail provider posts bounce and complaint reports with,
# at POST /api/mail/bounces. Empty disables that endpoint.
KOLIBRI_BOUNCE_TOKEN=

# ------------------------------------------------------------ the trash
# Days a deleted thing stays recoverable before it is removed for good. `0` —
# the default — keeps it until an admin empties the trash themselves, because a
# retention policy is a decision about somebody else's data. See
# docs/deployment.md.
KOLIBRI_TRASH_DAYS=0

# ---------------------------------------------------------------- backups
# `kolibri backup` has always worked. What this adds is the part that
# remembers to run it: name a directory and a snapshot is taken every night,
# opened to check it is readable, and kept to the count below.
#
# Off by default, because the copy belongs on a volume *other* than the one
# holding the database it exists to survive — and choosing where somebody
# else's backups live is not this program's decision. Mount one and say so.
KOLIBRI_BACKUP_DIR=

# Local hour to take it, 0–23.
KOLIBRI_BACKUP_HOUR=3

# How many snapshots to keep. A count rather than a number of days: a count is
# what a disk has room for, and an instance that was off for a fortnight should
# still have seven snapshots rather than none. `0` keeps every one.
KOLIBRI_BACKUP_KEEP=7

# Also copy each snapshot into the object store, so a lost machine is not a
# lost backup. Needs KOLIBRI_STORAGE=s3. The uploads travel under a shared,
# content-addressed prefix, so a nightly run whose files have not changed
# sends the database and nothing else.
KOLIBRI_BACKUP_OFFSITE=false
KOLIBRI_BACKUP_PREFIX=backups

# The largest export this instance will read back in. Bigger than an upload
# because it is a whole workspace rather than one file, and finite because an
# archive has to be in memory to be opened at all.
KOLIBRI_MAX_IMPORT_MB=200

# --------------------------------------------------------- object storage
# The default compose stack runs MinIO and sets this to `s3` for you; the
# bucket is created on first boot. Use `disk` (or docker-compose.lite.yml) to
# keep uploads in the data volume with no object store at all.
KOLIBRI_STORAGE=s3

KOLIBRI_S3_ENDPOINT=http://minio:9000
KOLIBRI_S3_BUCKET=kolibri
KOLIBRI_S3_REGION=us-east-1
KOLIBRI_S3_ACCESS_KEY=kolibri
# Change this before exposing the machine — it is also the MinIO console login.
KOLIBRI_S3_SECRET_KEY=kolibri-secret-change-me
# MinIO and Ceph use path-style addressing; AWS and R2 use a bucket subdomain.
KOLIBRI_S3_PATH_STYLE=true
# Serve downloads with a short-lived pre-signed URL instead of proxying bytes.
# Off in the compose stack, because a URL signed for `http://minio:9000` is not
# resolvable from a browser. Turn it on together with a public endpoint — the
# address the browser reaches MinIO on — to hand downloads to the object store.
KOLIBRI_S3_PRESIGN=false
KOLIBRI_S3_PUBLIC_ENDPOINT=
KOLIBRI_S3_PRESIGN_SECONDS=300

# ------------------------------------------------------------------- HTTPS
# docker compose --profile tls up -d
# Caddy obtains and renews the certificate for this name automatically.
# KOLIBRI_DOMAIN=kolibri.example.com
# KOLIBRI_PUBLIC_URL=https://kolibri.example.com

# ------------------------------------------------------------ compose files
# Uncomment to make plain `docker compose ...` always include the dev overlay
# (adds the Mailpit capture inbox and points the app at it).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --------------------------------------------------- admin ports (localhost)
# The MinIO console and the Mailpit inbox are bound to 127.0.0.1 by default;
# they are admin tools, not public services. Set the *_BIND values to 0.0.0.0
# only if you know why you want that.
# MINIO_CONSOLE_PORT=9001
# MINIO_API_PORT=9000
# MAILPIT_PORT=8025
# MINIO_CONSOLE_BIND=127.0.0.1
# MAILPIT_BIND=127.0.0.1
