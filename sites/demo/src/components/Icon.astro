---
/*
 * The dozen line icons this page uses, drawn inline.
 *
 * Inline rather than a sprite or a package because there are twelve of them,
 * they are one path each, and an icon font is a network request and a flash of
 * nothing in exchange for saving nobody any work. `currentColor` throughout,
 * so each one is the colour of the text it sits beside in both themes.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
}
const PATHS = {
  offline: '<path d="M2 8.8a13 13 0 0 1 6-3M22 8.8a13 13 0 0 0-6.2-3M5.5 12.4A8.5 8.5 0 0 1 9 10.6M18.5 12.4a8.5 8.5 0 0 0-3.2-1.7M9 15.8a4 4 0 0 1 3-1.3M12 19.5h.01M3 3l18 18"/>',
  board: '<rect x="3" y="4" width="5.5" height="16" rx="1.5"/><rect x="9.5" y="4" width="5.5" height="10" rx="1.5"/><rect x="16" y="4" width="5" height="13" rx="1.5"/>',
  page: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  cycle: '<path d="M3 12a9 9 0 0 1 15.5-6.2M21 12a9 9 0 0 1-15.5 6.2"/><path d="M18 3v3h-3M6 21v-3h3"/>',
  robot: '<rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V4M9 14h.01M15 14h.01M9.5 17.5h5"/>',
  chat: '<path d="M20 14a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z"/>',
  bell: '<path d="M18 9a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6M10.5 20a2 2 0 0 0 3 0"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3 1.8"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
  timeline: '<path d="M3 6h9M3 12h14M3 18h6"/><circle cx="15" cy="6" r="2"/><circle cx="20" cy="12" r="2"/><circle cx="11" cy="18" r="2"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/>',
  external: '<path d="M6.5 2.5H2.5v11h11v-4M9.5 2.5h4v4M13.5 2.5 7 9"/>',
  download: '<path d="M12 3v12M7.5 10.5 12 15l4.5-4.5M4 20h16"/>',
} as const;
const { name, size = 18 } = Astro.props;
// The two 16-box icons are drawn on a different grid from the rest; sharing one
// viewBox would silently crop them.
const box = name === 'external' ? 16 : 24;
---
<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox={`0 0 ${box} ${box}`}
  fill="none"
  stroke="currentColor"
  stroke-width={box === 16 ? 1.6 : 1.7}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={PATHS[name]}
/>
