---
/*
 * Light / dark / follow the OS.
 *
 * The inline script in `Layout.astro` is what prevents a flash of the wrong
 * theme; this is only the control. It cycles rather than toggles, because
 * "follow the OS" is a real third state and a two-way switch has nowhere to
 * put it — somebody who pinned light in March would otherwise have no way back
 * to automatic.
 */
---
<button class="btn btn--icon" id="theme" type="button" aria-label="Change theme">
  <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4.2"/>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/>
  </svg>
</button>

<script>
  const ORDER = ['auto', 'light', 'dark'] as const;
  const button = document.getElementById('theme');
  const label = { auto: 'Theme: follow the system', light: 'Theme: light', dark: 'Theme: dark' };

  /* Every read and write is guarded. A private window, a browser set to block
     site data and the thumbnailer all throw on `localStorage` rather than
     returning null, and an exception here would leave the page with no theme
     control at all. */
  const read = (): string => {
    try {
      return localStorage.getItem('kolibri-theme') ?? 'auto';
    } catch {
      return 'auto';
    }
  };

  const apply = (value: string) => {
    if (value === 'auto') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = value;
    button?.setAttribute('aria-label', label[value as keyof typeof label] ?? label.auto);
  };

  apply(read());

  button?.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(read() as (typeof ORDER)[number]) + 1) % ORDER.length]!;
    try {
      localStorage.setItem('kolibri-theme', next);
    } catch {
      /* Not storable here — the theme still applies for this page view. */
    }
    apply(next);
  });
</script>
