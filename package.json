{
  "name": "kolibri",
  "version": "0.1.0",
  "private": true,
  "description": "Kolibri \u2014 open source work OS: projects, tasks, cycles, pages. Offline-first, self-hosted, MCP-native.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web",
    "packages/mcp"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @kolibri/server",
    "dev:web": "npm run dev -w @kolibri/web",
    "build": "npm run build -w @kolibri/web",
    "mobile": "npm run cap:sync -w @kolibri/web",
    "mobile:ios": "npm run cap:ios -w @kolibri/web",
    "mobile:android": "npm run cap:android -w @kolibri/web",
    "start": "npm run start -w @kolibri/server",
    "seed": "npm run seed -w @kolibri/server",
    "doctor": "npm run doctor -w @kolibri/server",
    "kolibri": "npm run cli -w @kolibri/server --",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/server && tsc --noEmit -p packages/web && tsc --noEmit -p packages/web/tsconfig.test.json && tsc --noEmit -p packages/mcp",
    "test": "npm run test:server && npm run test:web && npm run test:checks",
    "test:server": "node --test packages/server/test/*.test.ts",
    "test:web": "node --import ./packages/web/test/loader.mjs --test packages/web/test/*.test.ts",
    "test:checks": "node --test scripts/*.test.mjs",
    "check:compose": "node scripts/compose-env.mjs",
    "check:modules": "node scripts/modules.mjs",
    "modules": "node scripts/modules.mjs --report",
    "check:figures": "node scripts/figures.mjs",
    "openapi": "node scripts/openapi.mjs --fix",
    "check:openapi": "node scripts/openapi.mjs",
    "check:css": "node scripts/unstyled.mjs",
    "check:responsive": "node scripts/responsive.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "check:a11y": "node scripts/a11y.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
